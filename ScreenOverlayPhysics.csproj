<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net9.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(TargetFramework)' == 'net9.0-windows'">WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF Condition="'$(TargetFramework)' == 'net9.0-windows'">true</UseWPF>
    <UseWindowsForms Condition="'$(TargetFramework)' == 'net9.0-windows'">true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
    <PackageReference Include="AssimpNet" Version="4.1.0" />
    <PackageReference Include="HelixToolkit.Wpf" Version="3.1.2" />
    <Compile Remove="Platforms/NonWindows/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net9.0-windows'">
    <Compile Remove="App.xaml.cs" />
    <Compile Remove="AssemblyInfo.cs" />
    <Compile Remove="ImportedModelOptionsWindow.cs" />
    <Compile Remove="MainWindow.xaml.cs" />
    <Compile Remove="SettingsWindow.cs" />
    <Compile Remove="Core/ConsoleLifetimeService.cs" />
    <Compile Remove="Core/DisplayBoundsService.cs" />
    <Compile Remove="Core/OverlayWindowService.cs" />
    <Compile Remove="Core/Win32Interop.cs" />
    <Compile Remove="Rendering/**/*.cs" />
    <Compile Remove="Scene/SceneController.cs" />
  </ItemGroup>

</Project>
