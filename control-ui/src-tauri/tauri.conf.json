{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenOverlayPhysics",
  "version": "0.1.0",
  "identifier": "com.xhawk.screenoverlayphysics.control",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ScreenOverlayPhysics Overlay UI",
        "label": "main",
        "width": 404,
        "height": 258,
        "minWidth": 360,
        "minHeight": 238,
        "fullscreen": false,
        "focus": false,
        "focusable": true,
        "transparent": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
